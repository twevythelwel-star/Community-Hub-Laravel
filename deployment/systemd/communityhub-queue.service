[Unit]
Description=Community Hub Queue Worker
After=network.target mysql.service redis-server.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/html
ExecStart=/usr/bin/php /var/www/html/artisan queue:work --queue=default,notifications --sleep=3 --tries=3 --backoff=10 --max-time=3600 --memory=256
Restart=always
RestartSec=5
TimeoutStopSec=60
KillMode=mixed

# Security hardening
ProtectSystem=full
ProtectHome=true
PrivateTmp=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
