# Rebuilt inside the image.
node_modules
vendor
public/build
public/hot
public/storage

# Secrets and local state never go into an image.
.env
.env.*
!.env.example
!.env.production.example
auth.json
database/database.sqlite
storage/logs/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
storage/app/public/*
storage/app/private/*
bootstrap/cache/*.php

# Development-only files.
.git
.claude
.vscode
.idea
.mcp.json
.phpunit.result.cache
tests
server.php
docker-compose.yml
Dockerfile
