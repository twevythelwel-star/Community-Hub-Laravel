APP_NAME="Community Hub"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Jamaica
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ── Database ─────────────────────────────────────────────────────────
# Use sqlite for a zero-setup local run: set DB_CONNECTION=sqlite and
# touch database/database.sqlite
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=community_hub
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SAME_SITE=lax
# Session cookie sent over HTTPS only. Defaults to true when APP_ENV=production.
# SESSION_SECURE_COOKIE=true

# Load balancer / reverse proxy addresses whose X-Forwarded-* headers to trust,
# comma-separated IPs or CIDRs, or * when the app is reachable only through it.
# Needed behind a TLS-terminating proxy, or the app thinks every request is http.
# TRUSTED_PROXIES=10.0.0.0/8

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# ── Digital Gate Pass Engine ─────────────────────────────────────────
# REQUIRED. Generate with: php artisan gatepass:secret
# This replaces GATE_ENGINE_SECRET, which was hardcoded in client-side
# JavaScript and therefore readable by anyone who opened the app.
# Never commit a real value.
GATE_ENGINE_SECRET=
GATE_COMMUNITY_ID=CID-CYPRESS-BAY
GATE_WINDOW_SECONDS=30

# ── AI (optional) ────────────────────────────────────────────────────
# Without a key, notification targeting falls back to the same
# deterministic output the original stub produced.
# Stripe. Leave blank and the checkout routes 404 rather than simulating
# a payment. Must begin with sk_ to be treated as live.
STRIPE_SECRET=
# Signing secret of the webhook endpoint at /api/webhooks/stripe (whsec_...).
# Without it the webhook route 404s. Locally, `stripe listen` prints one.
STRIPE_WEBHOOK_SECRET=

# Signs outbound notification webhooks (X-CommunityHub-Signature). Without it
# they are skipped rather than signed with a guessable key. `openssl rand -hex 32`.
NOTIFICATION_WEBHOOK_SECRET=

# Senders allowed to POST /api/v1/webhooks/incoming/{service}, comma-separated.
# Each needs its own {SERVICE}_WEBHOOK_SECRET, e.g. ACME_WEBHOOK_SECRET=...
INCOMING_WEBHOOK_SERVICES=

# API token lifetime in minutes (device sign-ins and personal tokens).
# 43200 = 30 days; 0 means tokens never expire.
SANCTUM_EXPIRATION=43200

# Public, unauthenticated payment links. Off until a driver settles funds.
PAYMENT_PUBLIC_LINKS_ENABLED=false

GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-2.0-flash

# ── SMS & WhatsApp (optional, Twilio) ──────────────────────────────────
# Without these the SMS and WhatsApp options are disabled, not faked.
# Account SID (AC...), then EITHER the Auth Token OR an API key pair (SK... + secret).
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_FROM=
TWILIO_WHATSAPP_FROM=
# Approved WhatsApp template for visitor passes (HX...). See WhatsAppService.
TWILIO_WHATSAPP_CONTENT_SID=
SMS_DEFAULT_COUNTRY_CODE=1

# ── Seeding ──────────────────────────────────────────────────────────
# Password given to every seeded demo account. Change before any real use.
SEED_PASSWORD=ChangeMe!2026

VITE_APP_NAME="${APP_NAME}"

# Card payments: stripe | wipay. Empty = Stripe if its keys are set, else card is off.
PAYMENTS_CARD_PROVIDER=
# Device wallets validated as enabled on this estate's merchant account with
# the card processor: apple_pay,google_pay. Empty = none offered.
PAYMENTS_WALLETS=
# In-person card readers (tap/insert): stripe_terminal. Empty = off.
PAYMENTS_IN_PERSON_PROVIDER=
# WiPay (https://wipaycaribbean.com). Sandbox: account 1234567890, API key 123.
WIPAY_ACCOUNT_NUMBER=
WIPAY_API_KEY=
WIPAY_ENVIRONMENT=sandbox
WIPAY_COUNTRY_CODE=JM
WIPAY_FEE_STRUCTURE=merchant_absorb

# ── Realtime broadcasting (optional, Laravel Reverb) ──────────────────
# Off unless BROADCAST_CONNECTION=reverb. There is no default secret: set
# your own, e.g. `php -r "echo bin2hex(random_bytes(32));"`.
BROADCAST_CONNECTION=null
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ── Backups (spatie/laravel-backup) ────────────────────────────────────
# Comma-separated disks from config/filesystems.php; local is fine here, not
# in production. Archives exclude .env and other secrets.
BACKUP_DISKS=local
BACKUP_ARCHIVE_PASSWORD=
BACKUP_NOTIFICATION_EMAIL=

# ── Safety & Emergency Services ────────────────────────────────────────
# Silent assistance escalation configuration
SAFETY_ARMED_MINUTES=15
SAFETY_QR_HOLD_SECONDS=3
SAFETY_DURESS_PIN_KEY=
# Emergency services escalation (false = requires manual authorization)
SAFETY_EMERGENCY_SERVICES_ENABLED=false
# Emergency service contact numbers (for reference by authorized personnel only)
SAFETY_POLICE_NUMBER=
SAFETY_MEDICAL_NUMBER=
SAFETY_FIRE_NUMBER=
# Require explicit confirmation before emergency services escalation
SAFETY_REQUIRE_EMERGENCY_CONFIRMATION=true

# Mobile wallet passes (config/wallet.php). Each wallet's button stays hidden
# until all of its values are set. Paths are absolute or under storage/app/private.
APPLE_WALLET_PASS_TYPE_ID=
APPLE_WALLET_TEAM_ID=
APPLE_WALLET_CERTIFICATE=
APPLE_WALLET_CERTIFICATE_PASSWORD=
APPLE_WALLET_WWDR_CERTIFICATE=
APPLE_WALLET_ORGANIZATION=
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_KEY=
GOOGLE_WALLET_CLASS_SUFFIX=estate_access
