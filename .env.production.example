# ==============================================================================
# COMMUNITY HUB - ENTERPRISE PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.production:
#   cp .env.production.example .env.production
#
# SECURITY DIRECTIVE:
# .env.production is gitignored. NEVER commit real credentials to source control.
# In cloud environments (AWS, GCP, Kubernetes, Docker Swarm), inject these values
# via an enterprise Secrets Manager (AWS Secrets Manager, Vault, or Doppler).
# ==============================================================================

# ── 1. Application & Core Identity ───────────────────────────────────────────
APP_NAME="Community Hub"
APP_ENV=production
# REQUIRED: Production debugging MUST be false to prevent stack trace leaks
APP_DEBUG=false
APP_TIMEZONE=America/Jamaica
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# REQUIRED: 32-character AES key. Generate with: php artisan key:generate --show
APP_KEY=

# ── 2. HTTPS & Reverse Proxy Termination ─────────────────────────────────────
# REQUIRED: Canonical public HTTPS address. Must strictly use https:// scheme.
APP_URL=https://hub.cypressbay.org

# Set to '*' if running behind an ingress controller, ALB, Cloudflare, or Caddy.
# Or provide the CIDR of the trusted proxy/load balancer (e.g., 10.0.0.0/16).
TRUSTED_PROXIES=*

# Session Cookie Hardening (Enforced over HTTPS)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# ── 3. Database: PostgreSQL or MySQL ──────────────────────────────────────────
# Select your primary relational engine ('pgsql' or 'mysql').
DB_CONNECTION=pgsql

# ── Option A: PostgreSQL (Recommended for Enterprise) ──
DB_HOST=postgres-cluster.internal
DB_PORT=5432
DB_DATABASE=community_hub_prod
DB_USERNAME=hub_app_user
DB_PASSWORD=
# SSL Mode for PostgreSQL (require, verify-ca, or verify-full)
DB_SSLMODE=require

# ── Option B: MySQL (Alternative) ──
# DB_CONNECTION=mysql
# DB_HOST=mysql-cluster.internal
# DB_PORT=3306
# DB_DATABASE=community_hub_prod
# DB_USERNAME=hub_app_user
# DB_PASSWORD=
# DB_CHARSET=utf8mb4
# DB_COLLATION=utf8mb4_unicode_ci

# ── 4. Cache & Distributed Session Store (Redis) ─────────────────────────────
CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis-cluster.internal
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_CACHE_DB=1

# ── 5. Queue Worker Configuration ────────────────────────────────────────────
# 'redis' or 'database'. In production, Redis queue yields high-throughput, low latency.
QUEUE_CONNECTION=redis
REDIS_QUEUE_DB=2

# Queue worker runtime parameters:
# Process daemon command:
#   php artisan queue:work redis --sleep=3 --tries=3 --backoff=10,60,300 --timeout=90 --max-time=3600
QUEUE_RETRY_AFTER=120

# ── 6. Scheduled Task Orchestration (Scheduler) ──────────────────────────────
# Executes console routes every minute:
#   * * * * * cd /var/www/html && php artisan schedule:run >> /dev/null 2>&1
# Scheduled jobs include:
#   - gatepass:prune-nonces (hourly)
#   - gatepass:expire (every 15 minutes)
#   - visitors:expire-no-shows (every 15 minutes)
#   - billing:reconciliation (daily at 02:00)
#   - backups:database (daily at 03:00)

# ── 7. Logging & Log Rotation ────────────────────────────────────────────────
# In containers, use 'stderr' or 'stack' with 'daily'.
# 'daily' automatically rotates log files with a configurable retention window.
LOG_CHANNEL=stack
LOG_STACK=daily,security,stderr,slack
LOG_LEVEL=warning

# Number of daily log files to retain before automatic pruning (14-30 days standard)
LOG_DAILY_DAYS=30

# Dedicated Security Audit Channel (writes to storage/logs/security.log)
# Retains gate access failures, deactivations, and security flags for 90 days.
LOG_SECURITY_DAYS=90

# ── 8. Monitoring & Healthchecks ─────────────────────────────────────────────
# Laravel 11 native liveness probe: /up
# Deep synthetic health check endpoint configuration:
HEALTH_CHECK_PATH=/up
HEALTH_CHECK_DISK_THRESHOLD_PERCENT=85
HEALTH_CHECK_QUEUE_MAX_PENDING=100

# ── 9. Error Tracking & Application Performance Monitoring (APM) ──────────────
# Sentry / Bugsnag exception reporting:
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2
SENTRY_PROFILES_SAMPLE_RATE=0.1
SENTRY_SEND_DEFAULT_PII=false

# ── 10. Alerting & Incident Escalation ────────────────────────────────────────
# Critical exception and outage alerts routed to Slack or Opsgenie/PagerDuty
LOG_SLACK_WEBHOOK_URL=
LOG_SLACK_USERNAME="Community Hub Production Alert"
LOG_SLACK_EMOJI=":rotating_light:"
LOG_SLACK_LEVEL=critical
ALERT_NOTIFICATION_EMAIL=ops@cypressbay.org

# ── 11. Database & Asset Backups ─────────────────────────────────────────────
# Offsite storage for encrypted snapshots
BACKUP_ENABLED=true
BACKUP_DISK=s3
BACKUP_RETENTION_DAYS=30
BACKUP_S3_KEY=
BACKUP_S3_SECRET=
BACKUP_S3_REGION=us-east-1
BACKUP_S3_BUCKET=cypressbay-hub-backups
BACKUP_ENCRYPTION_PASSPHRASE=

# ── 12. Digital Gate Pass Engine Secrets ──────────────────────────────────────
# REQUIRED: Cryptographic seed for HMAC-SHA256 time-windowed gate tokens.
# Generate with: php artisan gatepass:secret --show
GATE_ENGINE_SECRET=
GATE_COMMUNITY_ID=CID-CYPRESS-BAY
GATE_WINDOW_SECONDS=30

# ── 13. Production Payments & Verified Webhook Infrastructure ────────────────
# Stripe API Keys (Production 'live' credentials)
STRIPE_KEY=pk_live_...
STRIPE_SECRET=sk_live_...
# REQUIRED: Raw payload HMAC verification secret from Stripe Dashboard
STRIPE_WEBHOOK_SECRET=whsec_...
PAYMENT_PUBLIC_LINKS_ENABLED=true

# ── 14. Notification Providers (Production Telephony & Mail) ─────────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=notifications@cypressbay.org
MAIL_FROM_NAME="${APP_NAME}"

# Twilio SMS & WhatsApp Gateway (Real provider integration)
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_CONTENT_SID=
SMS_DEFAULT_COUNTRY_CODE=1

# ── 15. Generative AI Engine ──────────────────────────────────────────────────
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-2.0-flash

# ── 16. Realtime Broadcasting (Laravel Reverb) ────────────────────────────────
# Leave BROADCAST_CONNECTION=null unless a Reverb server is running. The secret
# has no fallback and must be unique to this deployment (64 random hex chars).
BROADCAST_CONNECTION=null
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=
REVERB_PORT=443
REVERB_SCHEME=https
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ── 17. Backups (spatie/laravel-backup) ───────────────────────────────────────
# Name an off-site disk: a backup kept only on this server dies with it. The
# archive password encrypts residents' data and is needed to restore; keep it in
# your secret store. Archives exclude .env, so restore secrets from there too.
BACKUP_DISKS=s3
BACKUP_ARCHIVE_PASSWORD=
BACKUP_NOTIFICATION_EMAIL=
